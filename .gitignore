# ============================================================
#  .gitignore  —  通用模板
#  每行一条规则；"#" 开头是注释；"!" 开头是例外（强制不忽略）
#  规则从上往下匹配，后面的规则会覆盖前面的
# ============================================================

# ============================================================
#  一、密钥 / 敏感信息  ← 最重要，请勿删除
#  注意：真正含密钥的文件必须在这里，且绝不能提交
# ============================================================
.env
.env.*
!.env.example
!.env.sample
!.env.template
.env.local
.env.*.local

*.pem
*.key
*.pfx
*.p12
*.keystore
*.jks
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk

secrets.json
secrets.yml
secrets.yaml
credential.json
credentials.json
credentials.yml
credentials.yaml
*credentials*.json
service-account*.json
*-service-account.json

.npmrc
.pypirc
.netrc
_netrc
auth.json
config.local.*
settings.local.*
*.secret
*.secrets

# ============================================================
#  二、依赖 / 构建产物
# ============================================================

# --- Node.js ---
node_modules/
bower_components/
jspm_packages/
.npm/
.yarn/cache/
.yarn/install-state.gz
.pnp.*
dist/
out/
.next/
.nuxt/
.output/
.vercel/
.turbo/
*.tsbuildinfo

